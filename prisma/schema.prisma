generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                     String     @id @default(cuid())
  username               String     @unique
  slugPrefix             String?    @unique
  email                  String     @unique
  googleProfilePicture   String?
  googleEmailVerified    Boolean    @default(false)
  googleEmailVerifiedAt  DateTime?
  fullName               String?
  firstName              String?
  lastName               String?
  address                String?
  city                   String?
  state                  String?
  zipCode                String?
  country                String?
  companyName            String?
  companyAddress         String?
  companyCity            String?
  companyState           String?
  companyZipCode         String?
  companyCountry         String?
  source                 String?
  contractNumber         String?
  telegramUsername       String?
  bkashNumber            String?
  publisherNumber        Int?       @unique
  leadNotifications      Boolean    @default(true)
  campaignEmailUpdates   Boolean    @default(true)
  clickRate              Float?     @default(0)
  commissionRate         Float?     @default(20)
  referralCommissionRate Float      @default(5)
  canUseSecretRedirect   Boolean    @default(true)
  payoutMethod           String?
  payoutAccount          String?
  paymentPasswordHash    String?
  password               String
  botFallbackUrl         String?
  // Publisher Global S2S postback URL (Developer Tools > Postback)
  globalPostbackUrl      String     @default("")
  globalPostbackEnabled  Boolean    @default(true)
  role                   UserRole   @default(PUBLISHER)
  status                 UserStatus @default(PENDING)
  referralCode           String?    @unique
  referredById           String?
  createdAt              DateTime   @default(now())
  updatedAt              DateTime   @updatedAt
  lastLogin              DateTime?

  linkAccounts                  LinkAccount[]
  publisherInvoices             PublisherPaymentInvoice[] @relation("PublisherInvoices")
  processedInvoices             PublisherPaymentInvoice[] @relation("ProcessedPublisherInvoices")
  referredBy                    User?                     @relation("UserReferrals", fields: [referredById], references: [id], onDelete: SetNull)
  referrals                     User[]                    @relation("UserReferrals")
  postbackConfigs               PostbackConfig[]
  conversionLeads               ConversionLead[]
  ownedSupportConversations     SupportConversation[]     @relation("SupportConversationManager")
  publisherSupportConversations SupportConversation[]     @relation("SupportConversationPublisher")
  sentSupportMessages           SupportMessage[]          @relation("SupportMessageSender")
  authoredNewsPosts             DashboardNewsPost[]        @relation("DashboardNewsAuthor")
  ownedIncentiveTools           IncentiveTool[]           @relation("IncentiveToolOwner")

  @@map("users")
}

model DashboardNewsPost {
  id        String   @id @default(cuid())
  title     String
  body      String
  authorId  String
  author    User     @relation("DashboardNewsAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([createdAt])
  @@map("dashboard_news_posts")
}

model IncentiveTool {
  id               String   @id
  kind             String
  name             String
  fields           Json
  toggles          Json
  selectedOfferIds String[] @default([])
  isPublished      Boolean  @default(true)
  ownerId          String
  owner            User     @relation("IncentiveToolOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  smartlinkVisitorCycles SmartlinkVisitorCycle[]
  smartlinkClicks  OfferClick[] @relation("SmartlinkOfferClicks")
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([ownerId, kind])
  @@index([kind, isPublished])
  @@map("incentive_tools")
}

model SmartlinkVisitorCycle {
  smartlinkId   String
  smartlink     IncentiveTool @relation(fields: [smartlinkId], references: [id], onDelete: Cascade)
  visitorHash   String
  countryCode   String
  seenOfferIds  String[]      @default([])
  updatedAt     DateTime      @updatedAt

  @@id([smartlinkId, visitorHash, countryCode])
  @@index([updatedAt])
  @@map("smartlink_visitor_cycles")
}

model OfferApplication {
  id                 String                 @id @default(cuid())
  campaignId         String
  campaignName       String
  campaignPayout     Float
  campaignCountry    String
  campaignCategory   String?
  campaignImage      String?
  publisherId        String
  publisherUsername  String
  publisherEmail     String?
  status             OfferApplicationStatus @default(PENDING)
  reviewNote         String?
  reviewedById       String?
  reviewedByUsername String?
  noticeDismissed    Boolean                @default(false)
  createdAt          DateTime               @default(now())
  updatedAt          DateTime               @updatedAt
  reviewedAt         DateTime?

  @@unique([publisherId, campaignId])
  @@index([status, createdAt])
  @@index([publisherId, status])
  @@index([publisherId, status, noticeDismissed])
  @@map("offer_applications")
}

/// Shared campaign catalog (browse + incentive). Visible to all authenticated roles.
model CampaignOffer {
  id                 String   @id
  name               String
  payout             Float
  country            String
  countries          String[] @default([])
  action             String   @default("Apply")
  requiresApproval   Boolean  @default(true)
  imageSource        String?
  offerTypes         String[] @default([])
  category           String?
  device             String[] @default([])
  description        String?
  offerLink          String?
  marketplaceOfferId String?  @unique
  isHot              Boolean  @default(false)
  status             String   @default("ACTIVE")
  placement          String   @default("STANDARD")
  incentiveActive    Boolean  @default(true)
  createdById        String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@index([placement, status])
  @@index([status, createdAt])
  @@map("campaign_offers")
}

/// Publisher tracking-link clicks (before marketplace conversion postback).
model OfferClick {
  id              String   @id @default(cuid())
  publisherNumber Int
  publisherUserId String?
  offerId         String
  smartlinkId     String?
  smartlink       IncentiveTool? @relation("SmartlinkOfferClicks", fields: [smartlinkId], references: [id], onDelete: SetNull)
  sub1            String?
  sub2            String?
  ipAddress       String?
  countryCode     String?
  userAgent       String?
  isUnique        Boolean  @default(true)
  createdAt       DateTime @default(now())

  @@index([publisherUserId, createdAt])
  @@index([publisherNumber, createdAt])
  @@index([publisherNumber, offerId, createdAt])
  @@index([publisherNumber, smartlinkId, createdAt])
  @@index([offerId, createdAt])
  @@index([createdAt])
  @@map("offer_clicks")
}

enum OfferApplicationStatus {
  PENDING
  APPROVED
  REJECTED
}

enum UserRole {
  MANAGER
  PUBLISHER
}

enum UserStatus {
  PENDING
  ACTIVE
  DISABLED
  REJECTED
}

model LinkAccount {
  id             String        @id @default(cuid())
  accountName    String
  slug           String        @unique
  customDomainId String?
  offerGroupName String?
  userId         String
  user           User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  isActive       Boolean       @default(true)

  payoutMethod        String?
  payoutAccount       String?
  paymentPasswordHash String?

  totalClicks                  Int @default(0)
  uniqueClicks                 Int @default(0)
  botClicks                    Int @default(0)
  usaSecretRedirectAccumulator Int @default(0)

  @@unique([slug, customDomainId])
  @@index([userId, offerGroupName])
  @@map("link_accounts")
}

enum PostbackProvider {
  CRACK_BOUNTY @map("AFFMINE")
  ADBLUMEDIA
  MARKETPLACE
}

model PostbackConfig {
  id         String           @id @default(cuid())
  userId     String
  user       User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider   PostbackProvider
  label      String
  token      String           @unique
  s1Token    String           @default("#s1#")
  s2Token    String           @default("#s2#")
  s3Token    String           @default("#s3#")
  s4Token    String           @default("#s4#")
  cmpidToken String           @default("#cmpid#")
  ipToken    String           @default("#ip#")
  isActive   Boolean          @default(true)
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt
  leads      ConversionLead[]

  @@index([token, isActive])
  @@map("postback_configs")
}

/// Inbound marketplace conversion credited to a publisher for one of our offers.
model ConversionLead {
  id                 String                   @id @default(cuid())
  userId             String
  user               User                     @relation(fields: [userId], references: [id], onDelete: Cascade)
  postbackId         String?
  postback           PostbackConfig?          @relation(fields: [postbackId], references: [id], onDelete: SetNull)
  offerId            String?
  campaignId         String?
  campaignName       String?
  payout             Float?
  country            String?
  city               String?
  device             String?
  os                 String?
  userAgent          String?
  status             String?
  externalTxId       String?
  ipAddress          String?
  sub1               String?
  sub2               String?
  sub3               String?
  sub4               String?
  publisherSub3      String?
  occurredAt         DateTime?
  externalKey        String?                  @unique
  publisherInvoiceId String?
  publisherInvoice   PublisherPaymentInvoice? @relation(fields: [publisherInvoiceId], references: [id], onDelete: SetNull)
  createdAt          DateTime                 @default(now())

  @@index([userId, createdAt])
  @@index([postbackId, createdAt])
  @@index([offerId, createdAt])
  @@index([publisherInvoiceId])
  @@index([externalTxId])
  @@map("conversion_leads")
}

model PublisherPaymentInvoice {
  id              String                 @id @default(cuid())
  invoiceNumber   String                 @unique
  publisherId     String
  publisher       User                   @relation("PublisherInvoices", fields: [publisherId], references: [id], onDelete: Cascade)
  totalEarning    Float
  conversionCount Int
  payoutMethod    String?
  payoutAccount   String?
  status          PublisherInvoiceStatus @default(PENDING)
  createdAt       DateTime               @default(now())
  paidAt          DateTime?
  paidById        String?
  paidBy          User?                  @relation("ProcessedPublisherInvoices", fields: [paidById], references: [id], onDelete: SetNull)
  conversions     ConversionLead[]

  @@index([publisherId, createdAt])
  @@index([status, createdAt])
  @@map("publisher_payment_invoices")
}

enum PublisherInvoiceStatus {
  PENDING
  PAID
}

model SupportConversation {
  id          String           @id @default(cuid())
  publisherId String
  publisher   User             @relation("SupportConversationPublisher", fields: [publisherId], references: [id], onDelete: Cascade)
  managerId   String?
  manager     User?            @relation("SupportConversationManager", fields: [managerId], references: [id], onDelete: SetNull)
  subject     String?
  status      SupportStatus    @default(OPEN)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  messages    SupportMessage[]

  @@index([publisherId, updatedAt])
  @@index([status, updatedAt])
  @@index([managerId, updatedAt])
  @@map("support_conversations")
}

model SupportMessage {
  id             String              @id @default(cuid())
  conversationId String
  conversation   SupportConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  senderId       String
  sender         User                @relation("SupportMessageSender", fields: [senderId], references: [id], onDelete: Cascade)
  body           String
  createdAt      DateTime            @default(now())

  @@index([conversationId, createdAt])
  @@map("support_messages")
}

model ContactInquiry {
  id        String               @id @default(cuid())
  firstName String
  lastName  String
  email     String
  message   String
  status    ContactInquiryStatus @default(OPEN)
  createdAt DateTime             @default(now())
  updatedAt DateTime             @updatedAt

  @@index([status, createdAt])
  @@map("contact_inquiries")
}

enum SupportStatus {
  OPEN
  RESOLVED
}

enum ContactInquiryStatus {
  OPEN
  RESOLVED
}
